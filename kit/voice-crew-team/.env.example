# Copy this file to .env and fill it in. Never commit .env.

# From the Claude Console (Settings > API keys). Kept on the server only.
ANTHROPIC_API_KEY=

# Printed by `ant apply` in step 3 of the README.
ENVIRONMENT_ID=
AGENT_ID_MICHAEL=
AGENT_ID_MIA=
AGENT_ID_LEO=
AGENT_ID_JIMMY=
AGENT_ID_RAPHAELLA=
AGENT_ID_JASON=
AGENT_ID_SARA=
AGENT_ID_FREYA=
AGENT_ID_MARTINA=

# The passcode the phone asks for. Required as soon as the server is reachable from the internet.
CREW_KEY=

# Optional
# MOCK=1                 try the screen with built-in demo answers, no API key needed
# MAX_REQUESTS_PER_MIN=40
# SESSION_MAX_USES=5     start a fresh conversation with a teammate after this many requests
# SESSION_BUDGET_CENTS=100   the most one teammate conversation may spend, in US cents (100 = $1.00); 0 = no cap
# ASK_TIMEOUT=180        seconds to wait for one answer

# Samsara (read-only): lets the team look up a truck's safety events by themselves.
# One line per company, each from that company's own Samsara dashboard (Settings > API Tokens).
# Give each token only "Read Vehicles" and "Read Safety Events & Scores". Never any write permission.
# The part after SAMSARA_TOKEN_ is the company's name, with underscores for spaces.
# SAMSARA_TOKEN_ABBAS_TRANSPORT=
# SAMSARA_TOKEN_RIVER_FREIGHT=
# SAMSARA_TOKEN=            use this one instead if you only have one company
# CREW_TZ=America/Chicago   the time zone your trucks work in; "Nov 11 to 12" is read in it
# SAMSARA_BASE=https://api.samsara.com    Europe: https://api.eu.samsara.com

# What the team may do, and the record of what it did (all optional)
# GRANTED=samsara           start with Samsara access already on. Without this the team asks first and waits for your yes.
#                           After the first run your taps and voice commands decide, and are remembered.
# GRANTS_FILE=              where the on/off choices are kept (default: next to STATE_FILE)
# ACTIVITY_FILE=            where the record of what the team did is kept (default: next to STATE_FILE)
